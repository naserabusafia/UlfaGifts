# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# Public NFC links returned by order APIs (no trailing slash required)
NFC_SETUP_BASE_URL=http://localhost:5173/setup
NFC_VIEW_BASE_URL=http://localhost:5173/nfc

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ulfa_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Encrypted media storage. "local" keeps files in STORAGE_LOCAL_DIR behind
# signed URLs (development); "s3" uses S3 or any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# Public URL of this API, used to build local signed URLs.
PUBLIC_API_URL=http://localhost:3000/api/v1
# S3_BUCKET=ulfa-media
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # only for S3-compatible services (MinIO, R2...)
# S3_FORCE_PATH_STYLE=false
