# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# Public NFC links returned by order APIs (no trailing slash required)
NFC_SETUP_BASE_URL=http://localhost:5173/setup
NFC_VIEW_BASE_URL=http://localhost:5173/nfc

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ulfa_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Encrypted media storage (S3 or any S3-compatible service). Required.
S3_BUCKET=
S3_REGION=il-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # only for S3-compatible services (MinIO, R2...)
# S3_FORCE_PATH_STYLE=false

# Hours a cancelled order keeps the buyer's uploads before they are deleted.
CANCELLED_CONTENT_RETENTION_HOURS=72
