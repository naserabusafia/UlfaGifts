# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# Public NFC links returned by order APIs (no trailing slash required)
NFC_SETUP_BASE_URL=http://localhost:5173/setup
NFC_VIEW_BASE_URL=http://localhost:5173/nfc

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ulfa_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
